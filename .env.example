# ─── Base de données (PostgreSQL 14+) ─────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/palette"

# ─── Sessions ─────────────────────────────────────────────────────────────────
# Secret de signature des cookies de session, 32 caractères minimum.
# Générer : openssl rand -base64 48
SESSION_SECRET="remplacer-par-une-longue-chaine-aleatoire-de-48-caracteres"

# ─── Stockage des photos ──────────────────────────────────────────────────────
# "local" : disque du serveur (dev, ou hébergeur avec volume persistant)
# "s3"    : service compatible S3 (Supabase Storage, Cloudflare R2, Scaleway, AWS S3…)
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"

# Requis si STORAGE_DRIVER="s3" (bucket privé : les photos sont servies par l'app après contrôle d'accès)
# S3_BUCKET="palette-photos"
# S3_REGION="eu-west-3"
# S3_ENDPOINT="https://<projet>.supabase.co/storage/v1/s3"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="true"

# Taille maximale d'une photo reçue par le serveur, en Mo (les photos sont compressées avant envoi).
MAX_UPLOAD_MB=8

# ─── Tests ────────────────────────────────────────────────────────────────────
# Bases dédiées aux tests : elles sont vidées / réinitialisées par les suites.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/palette_test"
E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/palette_e2e"
# Si Playwright ne trouve pas son navigateur : chemin vers un Chromium installé.
# PLAYWRIGHT_CHROMIUM_PATH=""

# ─── Données de démonstration ─────────────────────────────────────────────────
# Instance de test : charge les données de démo au démarrage si la base ne contient aucun compte.
# SEED_DEMO="true"
# Mots de passe des comptes de démo (npm run db:seed et SEED_DEMO)
# SEED_ADMIN_PASSWORD="Palette2026"
# SEED_CARPENTER_PASSWORD="Atelier2026"
